generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageInputMode {
  TEXT
  VOICE
}

enum MemoryApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemoryChangeOperation {
  CREATE
  UPDATE
  DELETE
}

enum MemoryDataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  OBJECT
  ARRAY
}

enum ProfileMemoryStatus {
  APPROVED
  DELETED
}

enum FormTaskStatus {
  CREATED
  FIELDS_DETECTED
  MAPPING_IN_PROGRESS
  AWAITING_INFORMATION
  REVIEW
  AWAITING_FINAL_APPROVAL
  APPROVED_FOR_FILLING
  FILLING
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum FieldValueSource {
  USER_PROVIDED
  PROFILE_MEMORY
  CONVERSATION
  USER_INPUT
  AI_SUGGESTION
  APPROVED_PROFILE_MEMORY
  AGENT_PROPOSED
  SYSTEM_DEFAULT
  USER_CORRECTED
}

enum FieldValueStatus {
  NOT_REVIEWED
  PENDING_APPROVAL
  PROPOSED
  APPROVED
  FILLED
  REJECTED
  FAILED
}

enum FormFieldStatus {
  ACTIVE
  REMOVED
}

enum FieldExecutionStatus {
  NOT_STARTED
  READY
  IN_PROGRESS
  FILLED
  SKIPPED
  FAILED
}

enum MappingSource {
  DETERMINISTIC
  INTERNAL
  USER
}

enum BrowserExecutionStatus {
  ISSUED
  IN_PROGRESS
  PARTIAL
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum BrowserActionStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  CANCELLED
}

enum ApprovalType {
  PROFILE_MEMORY
  FORM_FILL
  FORM_SUBMISSION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique @db.VarChar(320)
  passwordHash         String                @map("password_hash") @db.VarChar(255)
  fullName             String                @map("full_name") @db.VarChar(200)
  preferredLanguage    String?               @map("preferred_language") @db.VarChar(20)
  status               AccountStatus         @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens        RefreshToken[]
  conversations        Conversation[]
  profileMemories      ProfileMemory[]
  memoryChangeRequests MemoryChangeRequest[]
  formTasks            FormTask[]
  approvals            Approval[]
  auditLogs            AuditLog[]
  browserPageSessions  BrowserPageSession[]
  browserExecutions    BrowserExecution[]

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Conversation {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  title                String?               @db.VarChar(255)
  status               ConversationStatus    @default(ACTIVE)
  summary              String?
  startedAt            DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  lastMessageAt        DateTime?             @map("last_message_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(3)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages             Message[]
  profileMemories      ProfileMemory[]
  memoryChangeRequests MemoryChangeRequest[]
  formTasks            FormTask[]
  approvals            Approval[]

  @@index([userId, lastMessageAt])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  inputMode      MessageInputMode  @map("input_mode")
  language       String?           @db.VarChar(20)
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  revisions      MessageRevision[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageRevision {
  id              String   @id @default(uuid()) @db.Uuid
  messageId       String   @map("message_id") @db.Uuid
  previousContent String   @map("previous_content")
  revisionNumber  Int      @map("revision_number")
  revisedAt       DateTime @default(now()) @map("revised_at") @db.Timestamptz(3)
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, revisionNumber])
  @@index([messageId, revisedAt])
  @@map("message_revisions")
}

model ProfileMemory {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  category             String                @db.VarChar(100)
  key                  String                @db.VarChar(150)
  value                Json
  dataType             MemoryDataType        @default(STRING) @map("data_type")
  status               ProfileMemoryStatus   @default(APPROVED)
  sourceConversationId String?               @map("source_conversation_id") @db.Uuid
  sourceMessageId      String?               @map("source_message_id") @db.Uuid
  isApproved           Boolean               @default(false) @map("is_approved")
  approvedAt           DateTime?             @map("approved_at") @db.Timestamptz(3)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceConversation   Conversation?         @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  memoryChangeRequests MemoryChangeRequest[]

  @@unique([userId, category, key])
  @@index([userId, isApproved])
  @@index([sourceConversationId])
  @@index([sourceMessageId])
  @@index([userId, category, key, status])
  @@map("profile_memories")
}

model MemoryChangeRequest {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  conversationId   String?               @map("conversation_id") @db.Uuid
  sourceMessageId  String?               @map("source_message_id") @db.Uuid
  existingMemoryId String?               @map("existing_memory_id") @db.Uuid
  operation        MemoryChangeOperation
  category         String                @default("OTHER") @db.VarChar(100)
  proposedKey      String                @map("proposed_key") @db.VarChar(150)
  proposedValue    Json                  @map("proposed_value")
  previousValue    Json?                 @map("previous_value")
  status           MemoryApprovalStatus  @default(PENDING)
  reviewedAt       DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason  String?               @map("rejection_reason") @db.VarChar(500)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation     Conversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  existingMemory   ProfileMemory?        @relation(fields: [existingMemoryId], references: [id], onDelete: Restrict)
  approvals        Approval[]

  @@index([userId, status])
  @@index([conversationId])
  @@index([existingMemoryId])
  @@index([sourceMessageId])
  @@index([userId, category, proposedKey, status])
  @@map("memory_change_requests")
}

model FormTask {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  conversationId      String               @map("conversation_id") @db.Uuid
  title               String?              @db.VarChar(255)
  taskType            String               @default("APPLICATION") @map("task_type") @db.VarChar(100)
  webpageUrl          String               @map("webpage_url") @db.Text
  webpageTitle        String?              @map("webpage_title") @db.VarChar(500)
  domain              String?              @db.VarChar(255)
  status              FormTaskStatus       @default(PENDING)
  taskMetadata        Json?                @map("task_metadata")
  webpageMetadata     Json?                @map("webpage_metadata")
  detectedAt          DateTime?            @map("detected_at") @db.Timestamptz(3)
  startedAt           DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  pausedAt            DateTime?            @map("paused_at") @db.Timestamptz(3)
  failedAt            DateTime?            @map("failed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  previousStatus      FormTaskStatus?      @map("previous_status")
  version             Int                  @default(1)
  failureCode         String?              @map("failure_code") @db.VarChar(100)
  failureMessage      String?              @map("failure_message") @db.VarChar(500)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation        Conversation         @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  detectedFields      DetectedField[]
  taskEvents          TaskEvent[]
  approvals           Approval[]
  mappings            FieldMapping[]
  browserPageSessions BrowserPageSession[]
  browserExecutions   BrowserExecution[]

  @@index([userId, status])
  @@index([conversationId, createdAt])
  @@index([status])
  @@index([userId, createdAt])
  @@map("form_tasks")
}

model DetectedField {
  id                   String                @id @default(uuid()) @db.Uuid
  formTaskId           String                @map("form_task_id") @db.Uuid
  fieldIdentifier      String                @map("field_identifier") @db.VarChar(255)
  fieldKey             String?               @map("field_key") @db.VarChar(255)
  label                String                @db.VarChar(500)
  name                 String?               @db.VarChar(255)
  elementType          String                @map("element_type") @db.VarChar(50)
  inputType            String                @map("input_type") @db.VarChar(50)
  placeholder          String?               @db.VarChar(500)
  isRequired           Boolean               @default(false) @map("is_required")
  isDisabled           Boolean               @default(false) @map("is_disabled")
  isReadOnly           Boolean               @default(false) @map("is_read_only")
  detectedOrder        Int?                  @map("detected_order")
  groupName            String?               @map("group_name") @db.VarChar(255)
  sectionName          String?               @map("section_name") @db.VarChar(255)
  detectionConfidence  Decimal?              @map("detection_confidence") @db.Decimal(4, 3)
  status               FormFieldStatus       @default(ACTIVE)
  options              Json?
  fieldMetadata        Json?                 @map("field_metadata")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  formTask             FormTask              @relation(fields: [formTaskId], references: [id], onDelete: Cascade)
  fieldValues          FieldValue[]
  mappings             FieldMapping[]
  browserActionResults BrowserActionResult[]

  @@unique([formTaskId, fieldIdentifier])
  @@index([formTaskId])
  @@map("detected_fields")
}

model FieldValue {
  id                String               @id @default(uuid()) @db.Uuid
  detectedFieldId   String               @map("detected_field_id") @db.Uuid
  value             Json
  source            FieldValueSource
  sourceReferenceId String?              @map("source_reference_id") @db.Uuid
  confidence        Decimal?             @db.Decimal(4, 3)
  status            FieldValueStatus
  executionStatus   FieldExecutionStatus @default(NOT_STARTED) @map("execution_status")
  dataType          String?              @map("data_type") @db.VarChar(30)
  sourceMemoryId    String?              @map("source_memory_id") @db.Uuid
  attemptCount      Int                  @default(0) @map("attempt_count")
  lastAttemptAt     DateTime?            @map("last_attempt_at") @db.Timestamptz(3)
  lastError         String?              @map("last_error") @db.VarChar(500)
  approvedAt        DateTime?            @map("approved_at") @db.Timestamptz(3)
  filledAt          DateTime?            @map("filled_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  detectedField     DetectedField        @relation(fields: [detectedFieldId], references: [id], onDelete: Cascade)
  revisions         FieldValueRevision[]

  @@index([detectedFieldId, createdAt])
  @@index([status])
  @@map("field_values")
}

model TaskEvent {
  id             String          @id @default(uuid()) @db.Uuid
  formTaskId     String          @map("form_task_id") @db.Uuid
  eventType      String          @map("event_type") @db.VarChar(100)
  previousStatus FormTaskStatus? @map("previous_status")
  newStatus      FormTaskStatus? @map("new_status")
  description    String?
  metadata       Json?
  entityId       String?         @map("entity_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  formTask       FormTask        @relation(fields: [formTaskId], references: [id], onDelete: Cascade)

  @@index([formTaskId, createdAt])
  @@map("task_events")
}

model FieldValueRevision {
  id             String            @id @default(uuid()) @db.Uuid
  fieldValueId   String            @map("field_value_id") @db.Uuid
  previousValue  Json              @map("previous_value")
  previousStatus FieldValueStatus? @map("previous_status")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  fieldValue     FieldValue        @relation(fields: [fieldValueId], references: [id], onDelete: Cascade)

  @@index([fieldValueId, createdAt])
  @@map("field_value_revisions")
}

model FieldMapping {
  id              String        @id @default(uuid()) @db.Uuid
  formTaskId      String        @map("form_task_id") @db.Uuid
  detectedFieldId String        @map("detected_field_id") @db.Uuid
  sourceMemoryId  String?       @map("source_memory_id") @db.Uuid
  sourceKey       String?       @map("source_key") @db.VarChar(150)
  confidence      Decimal       @db.Decimal(4, 3)
  source          MappingSource
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  formTask        FormTask      @relation(fields: [formTaskId], references: [id], onDelete: Cascade)
  detectedField   DetectedField @relation(fields: [detectedFieldId], references: [id], onDelete: Cascade)

  @@unique([formTaskId, detectedFieldId])
  @@index([formTaskId])
  @@map("field_mappings")
}

model Approval {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  conversationId        String?              @map("conversation_id") @db.Uuid
  formTaskId            String?              @map("form_task_id") @db.Uuid
  memoryChangeRequestId String?              @map("memory_change_request_id") @db.Uuid
  approvalType          ApprovalType         @map("approval_type")
  status                ApprovalStatus       @default(PENDING)
  approvedPayload       Json?                @map("approved_payload")
  approvedAt            DateTime?            @map("approved_at") @db.Timestamptz(3)
  revokedAt             DateTime?            @map("revoked_at") @db.Timestamptz(3)
  taskVersion           Int?                 @map("task_version")
  approvedSnapshot      Json?                @map("approved_snapshot")
  invalidatedAt         DateTime?            @map("invalidated_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation          Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  formTask              FormTask?            @relation(fields: [formTaskId], references: [id], onDelete: Restrict)
  memoryChangeRequest   MemoryChangeRequest? @relation(fields: [memoryChangeRequestId], references: [id], onDelete: Restrict)
  browserExecutions     BrowserExecution[]

  @@index([userId, status])
  @@index([conversationId])
  @@index([formTaskId])
  @@index([memoryChangeRequestId])
  @@map("approvals")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String   @map("resource_id") @db.Uuid
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model BrowserPageSession {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  formTaskId      String             @map("form_task_id") @db.Uuid
  protocolVersion String             @map("protocol_version") @db.VarChar(50)
  pageUrl         String             @map("page_url") @db.Text
  origin          String             @db.Text
  hostname        String             @db.VarChar(255)
  pageTitle       String?            @map("page_title") @db.VarChar(500)
  fingerprint     String?            @db.VarChar(255)
  tabId           String?            @map("tab_id") @db.VarChar(255)
  idempotencyKey  String             @map("idempotency_key") @db.VarChar(255)
  idempotencyHash String?            @map("idempotency_hash") @db.Char(64)
  detectedAt      DateTime           @map("detected_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  formTask        FormTask           @relation(fields: [formTaskId], references: [id], onDelete: Cascade)
  executions      BrowserExecution[]

  @@unique([userId, idempotencyKey])
  @@index([userId, formTaskId])
  @@map("browser_page_sessions")
}

model BrowserExecution {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  formTaskId      String                 @map("form_task_id") @db.Uuid
  pageSessionId   String                 @map("page_session_id") @db.Uuid
  approvalId      String                 @map("approval_id") @db.Uuid
  protocolVersion String                 @map("protocol_version") @db.VarChar(50)
  taskVersion     Int                    @map("task_version")
  idempotencyKey  String                 @map("idempotency_key") @db.VarChar(255)
  idempotencyHash String?                @map("idempotency_hash") @db.Char(64)
  retryActionIds  String[]               @default([]) @map("retry_action_ids") @db.Uuid
  status          BrowserExecutionStatus @default(ISSUED)
  instruction     Json
  expiresAt       DateTime               @map("expires_at") @db.Timestamptz(3)
  cancelledAt     DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  acknowledgedAt  DateTime?              @map("acknowledged_at") @db.Timestamptz(3)
  retryCount      Int                    @default(0) @map("retry_count")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  formTask        FormTask               @relation(fields: [formTaskId], references: [id], onDelete: Cascade)
  pageSession     BrowserPageSession     @relation(fields: [pageSessionId], references: [id], onDelete: Cascade)
  approval        Approval               @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  results         BrowserActionResult[]

  @@unique([userId, idempotencyKey])
  @@index([formTaskId, status])
  @@map("browser_executions")
}

model BrowserActionResult {
  id            String              @id @default(uuid()) @db.Uuid
  executionId   String              @map("execution_id") @db.Uuid
  fieldId       String              @map("field_id") @db.Uuid
  actionId      String              @map("action_id") @db.VarChar(255)
  status        BrowserActionStatus
  errorCode     String?             @map("error_code") @db.VarChar(100)
  message       String?             @db.VarChar(500)
  executedAt    DateTime?           @map("executed_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  execution     BrowserExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  detectedField DetectedField       @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([executionId, fieldId])
  @@index([executionId, status])
  @@map("browser_action_results")
}
