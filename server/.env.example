GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=
GROQ_MODEL=

GNANI=
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=auto
GNANI_TTS_SPEED=1.0
GNANI_TTS_SAMPLE_RATE=24000
GNANI_TTS_CONTAINER=raw
GNANI_TTS_ENCODING=linear_pcm

TEST_DATABASE_URL="postgresql://test_user:test_password@localhost:5432/bhashaagent_test?schema=public"

NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bhashaagent?schema=public"
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_ISSUER="bhashaagent"
JWT_AUDIENCE="bhashaagent-api"
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
